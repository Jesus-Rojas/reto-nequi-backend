# Copia este archivo a terraform.tfvars y ajusta los valores.
# NUNCA subas terraform.tfvars al repositorio si contiene secretos.

project_name   = "reto-nequi"
environment    = "dev"
aws_region     = "us-east-1"

# Red — CIDR exclusivo para el backend (no solapar con el frontend)
vpc_cidr           = "10.1.0.0/16"
public_subnet_cidr = "10.1.1.0/24"
availability_zone  = "us-east-1a"

# EC2 — key_pair_name debe existir previamente en AWS
key_pair_name       = "mi-key-pair"
instance_type       = "t3.small"
root_volume_size_gb = 20

# Repositorio
repo_url = "https://github.com/Jesus-Rojas/reto-nequi"

# Aplicación — cambia por un valor seguro
app_api_key           = "nequi-secret-key-change-in-production"
rate_limit_per_minute = 60

# SSH — restringe a tu IP en producción: ["X.X.X.X/32"]
allowed_ssh_cidrs = ["0.0.0.0/0"]
